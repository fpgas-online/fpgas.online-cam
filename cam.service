# Ansible Managed

[Install]
WantedBy=multi-user.target

[Unit]
Description=stream video to nginx-rtmp
After=network-online.target
Wants=network-online.target
StartLimitInterval=0

[Service]
ExecStart=/usr/local/bin/fpgas-gst-libcam.sh
Restart=always
RestartSec=1
# 78 = gst-libcam.sh found no camera. Stay stopped: a CSI camera can only be
# connected with the board off; other failures (e.g. the stream server
# restarting) keep retrying.
RestartPreventExitStatus=78
